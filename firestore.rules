rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nexus Veritas Certification - Regras de Acesso e Sincronização em Tempo Real
    
    // Teste de conexão
    match /test/connection {
      allow read, write: if true;
    }

    // Parceiros e landing institucional
    match /partners/{partnerId} {
      allow read, write: if true;
    }

    // Fornecedores e gestão documental GED
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // Auditorias de conformidade (1ª, 2ª e 3ª partes)
    match /audits/{auditId} {
      allow read, write: if true;
    }

    // Certificados oficiais emitidos e validação pública
    match /certificates/{certificateId} {
      allow read, write: if true;
    }

    // Planos de Ação CAPA (5W2H e Ishikawa)
    match /action_plans/{planId} {
      allow read, write: if true;
    }

    // Indicadores e métricas de desempenho (IQF)
    match /indicators/{indicatorId} {
      allow read, write: if true;
    }

    // Documentos SGQ e procedimentos controlados
    match /documents/{docId} {
      allow read, write: if true;
    }

    // Trilha de auditoria contínua (LGPD)
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Rede profissional de auditores
    match /professionals/{profId} {
      allow read, write: if true;
    }

    // Cursos e qualificações Academy
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Chamados e suporte ao corpo técnico
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Usuários e perfis RBAC
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
